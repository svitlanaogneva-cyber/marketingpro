# Заявки з форм → Google Sheets (Apps Script). Див. integrations/google-sheets/README.md
# URL веб-застосунку Apps Script (закінчується на /exec)
LEAD_WEBHOOK_URL=
# Секрет, який показує меню «marketingpro → Показати секрет» у таблиці
LEAD_WEBHOOK_SECRET=

# Необовʼязково: домен для метаданих (за замовчуванням https://marketingpro.company)
# NEXT_PUBLIC_SITE_URL=

# Необовʼязково: аналітика. Без цих змінних жодні скрипти не вантажаться.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=1234567890
